// Repository tooling that runs directly in Node.js: the ESLint and Vitest configurations and the
// scripts in scripts/. Node.js runs the TypeScript files without a build step (type stripping), so only
// erasable TypeScript syntax is allowed and imports keep their .ts extension.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "${configDir}",
    "outDir": "${configDir}/dist/tooling",
    "tsBuildInfoFile": "${configDir}/dist/tooling/tsconfig.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    // `npm run brand:rasters` drives Playwright's Chromium and passes a function that runs in the
    // page, so the scripts see the DOM like the other Playwright projects (ADR 0089).
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "${configDir}/eslint.config.js",
    "${configDir}/vitest.config.ts",
    "${configDir}/scripts"
  ]
}
