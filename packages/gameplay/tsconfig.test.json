// Tests of the gameplay package. Vitest's type declarations need Node.js globals, so only this
// project gets Node types. ESLint still forbids Node.js imports in every gameplay file, tests
// included (ADR 0030); tests read the stored example saves with Vite's `import.meta.glob`, whose
// declaration comes without the DOM types of `vite/client`.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "${configDir}/dist/test",
    "tsBuildInfoFile": "${configDir}/dist/test/tsconfig.tsbuildinfo",
    "types": ["node", "vite/types/importMeta.d.ts"]
  },
  "include": ["${configDir}/src/**/*.test.ts"],
  "references": [
    { "path": "./tsconfig.lib.json" },
    { "path": "../engine/tsconfig.lib.json" },
    { "path": "../content/tsconfig.lib.json" }
  ]
}
