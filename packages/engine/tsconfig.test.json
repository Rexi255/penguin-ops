// Tests of the engine. Vitest's type declarations need Node.js globals (for example
// AbortSignal), so only this project gets Node types. ESLint still forbids Node.js imports in
// every engine file, tests included (ADR 0030).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "${configDir}/dist/test",
    "tsBuildInfoFile": "${configDir}/dist/test/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["${configDir}/src/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
