{
  "name": "penguin-ops",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop learning game for Linux commands.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/content",
    "packages/gameplay",
    "apps/ui",
    "apps/desktop"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "test:lint-rules": "node --test scripts/lint-rules.test.ts"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
