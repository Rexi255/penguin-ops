{
  "name": "penguin-ops",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop learning game for Linux commands.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/content",
    "packages/gameplay",
    "apps/ui",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @penguin-ops/desktop",
    "build": "npm run build -w @penguin-ops/desktop",
    "e2e": "npm run e2e -w @penguin-ops/desktop",
    "package": "npm run package -w @penguin-ops/desktop",
    "e2e:packaged": "npm run e2e:packaged -w @penguin-ops/desktop",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:docs-duty": "node scripts/check-docs-duty.ts",
    "adr:new": "node scripts/new-adr.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run check:licenses"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
