# Prettier also skips everything in .gitignore.

# Markdown is wrapped by hand at 100 characters, and accepted decision records must not be
# rewritten (ADR 0029).
*.md

# Generated by npm.
package-lock.json

# Generated from the zod schemas; a content test keeps it up to date (ADR 0068).
content/schemas/

# Third-party skill copied unchanged from its pinned release (ADR 0080).
.claude/skills/impeccable/

# impeccable's local runtime output (sketches, decision pages, review captures). Its folders
# ignore themselves for git with their own .gitignore, which Prettier does not read (ADR 0081).
**/.impeccable/mocks/
**/.impeccable/questions/
**/.impeccable/review/
